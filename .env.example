# Which LLM provider get_llm() uses: "openai" or "groq"
LLM_PROVIDER=groq

# --- Groq (used when LLM_PROVIDER=groq) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional override (default: openai/gpt-oss-20b).
# List models your key can use: GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-20b

# --- OpenAI (used when LLM_PROVIDER=openai) ---
# Not required if LLM_PROVIDER=groq (embeddings run locally).
OPENAI_API_KEY=your_openai_api_key_here

# --- Embeddings (open-source, runs locally, no API key) ---
# Optional override (default: sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
